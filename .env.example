# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# MySQL container credentials (used by both the mysql service and the PHP backend)
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=patrdb
MYSQL_USER=patr_app
MYSQL_PASSWORD=changeme-app-password

# Public URL of this deployment - used for building email links (invite approvals)
# and uploaded media URLs. Update this if you move from an IP to a domain.
APP_BASE_URL=http://18.217.190.97

# SMTP (Hostinger mailbox) used for invite-approval / notification emails
SMTP_HOST=smtp.hostinger.com
SMTP_USER=admin@patr.me
SMTP_PASSWORD=changeme-smtp-password
